# OmniRoute API Configuration
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# Database
DATABASE_URL=sqlite:///./olaisearch.db

# Redis (for Celery, optional in dev mode)
REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=file:./mlflow

# Application Settings
DEBUG=true
LOG_LEVEL=INFO

# Model Configuration
VLM_MODEL_ID=gpt-4-vision-preview
TEXT_LLM_MODEL_ID=gpt-4-turbo-preview
EMBEDDER_MODEL_ID=text-embedding-3-large

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Provider settings
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=3
