# OlaiSearch Environment Configuration
# Copy this to .env and fill in your keys. Never commit .env.

# ─── AI Providers (OmniRoute OpenAI-compatible) ───────────────────────────────
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_API_KEY=your_api_key_here

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///olaisearch.db
REDIS_URL=redis://localhost:6379/0

# ─── ML / AI Models ───────────────────────────────────────────────────────────
# See config/models.yaml for the full model mapping
OMNIROUTE_VLM_OCR_MODEL=vlm_ocr
OMNIROUTE_TEXT_LLM_MODEL=text_llm
OMNIROUTE_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Tesseract ────────────────────────────────────────────────────────────────
# Should already be installed; no env vars needed on Windows
# PATH must include tesseract and tessdata (tessdata/langs)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_DATA_DIR=C:\Program Files\Tesseract-OCR\tessdata

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# ─── Optional: MLFlow for experiment tracking ──────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
